#!/usr/bin/env bash
# lane - the mac-lane wrapper: the one allowlisted path for lane work.
#
# One named task gets one tmux session (the spine) attached into one herdr
# workspace tab (the viewer), running an interactive Claude Code session.
# Subcommands cover the whole lane lifecycle: health, up, prompt, read, list,
# stop, control. There is deliberately no way to reach bash/sh/python/ssh/tmux/herdr
# through this script: every external call below is a fixed binary with
# validated arguments, so an allowlist entry for this path admits lane
# operations and nothing else.
#
# Idempotency: a prompt job is recorded in the ledger BEFORE anything is sent,
# keyed by a caller-supplied job id (use the GitHub issue number). A retried
# job with the same id prints the recorded entry and exits without
# re-sending, so a refiled issue cannot duplicate the work.
#
# Layout:
#   ~/.config/issue-bridge/lanes/<name>/state      active | archived
#   ~/.config/issue-bridge/lanes/<name>/workspace  herdr workspace id
#   ~/.config/issue-bridge/lanes/<name>/jobs/<id>  one record per prompt job
#   ~/lanes/<name>/                                the lane's working directory
set -euo pipefail

# launchd hands the poller a minimal PATH; brew tools live outside it. The
# fixed dirs come first so a weird inherited PATH cannot shadow system tools.
PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"
export PATH

CONF="${ISSUE_BRIDGE_HOME:-$HOME/.config/issue-bridge}"
REGISTRY="$CONF/lanes"
LANES_ROOT="${ISSUE_BRIDGE_LANES_ROOT:-$HOME/lanes}"
CLAUDE_BIN="${ISSUE_BRIDGE_LANE_CLAUDE:-claude}"
MAX_PROMPT=12000
MAX_READ=500

err()  { printf '%s\n' "$*" >&2; }
die()  { err "lane: $*"; exit 1; }
usage() { err "usage: $2"; exit "$1"; }

# Lane names double as tmux session names and herdr labels. This charset is
# safe in both (no ':' '.' '%', which tmux target syntax treats specially)
# and forces the plain-language lowercase style he asked for.
valid_name() { [[ "$1" =~ ^[a-z][a-z0-9-]{0,30}$ ]]; }
valid_job()  { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]; }

session_of() { printf 'lane-%s' "$1"; }

have_session() { tmux has-session -t "$1" 2>/dev/null; }

# What the lane's pane is running right now: claude, node, zsh, ...
pane_cmd() { tmux display-message -p -t "$1" '#{pane_current_command}' 2>/dev/null || true; }

LANE_LOCK=""
try_lock_lane() { # <lane dir> [attempts] - never fatal; 3 attempts is "only if it is free"
  local lockdir="$1/.lock" i=0
  while [ "$i" -lt "${2:-3}" ]; do
    if mkdir "$lockdir" 2>/dev/null; then
      LANE_LOCK="$lockdir"
      trap 'rmdir "$LANE_LOCK" 2>/dev/null || true' EXIT
      return 0
    fi
    sleep 0.2
    i=$((i + 1))
  done
  return 1
}

lock_lane() {
  # mkdir is atomic on macOS: one holder, everyone else waits. The poller
  # runs jobs serially, but a manual lane call can overlap with a job.
  try_lock_lane "$1" 50 || die "another lane operation is holding $1"
}

agent_running() {
  case "$(pane_cmd "$1")" in
    claude|node|[0-9]*.[0-9]*.[0-9]*) return 0 ;;
    *) return 1 ;;
  esac
}

shell_waiting() {
  case "$(pane_cmd "$1")" in
    zsh|bash|sh|fish) return 0 ;;
    *) return 1 ;;
  esac
}

# --- herdr (viewer only; every failure here is a warning, never fatal) -----

herdr_ok() { command -v herdr >/dev/null 2>&1 && herdr status >/dev/null 2>&1; }

json_field() { # json_field <dotted.path> - read one field from JSON on stdin
  python3 -c 'import json,sys
d = json.load(sys.stdin)
for part in sys.argv[1].split("."):
    d = d[part]
print(d)' "$1" 2>/dev/null
}

herdr_ensure_workspace() { # <name> <dir> <session> -> prints id or nothing
  local name="$1" dir="$2" session="$3" wid pane out
  herdr_ok || { err "lane: warn: herdr unavailable; lane works in tmux but is not on the board"; return 0; }
  if [ -s "$REGISTRY/$name/workspace" ]; then
    wid="$(cat "$REGISTRY/$name/workspace")"
    if herdr workspace get "$wid" >/dev/null 2>&1; then
      printf '%s' "$wid"
      return 0
    fi
  fi
  out="$(herdr workspace create --cwd "$dir" --label "$name" --no-focus 2>/dev/null)" || {
    err "lane: warn: herdr workspace create failed; lane works in tmux but is not on the board"
    return 0
  }
  wid="$(printf '%s' "$out" | json_field result.workspace.workspace_id)"
  pane="$(printf '%s' "$out" | json_field result.root_pane.pane_id)"
  [ -n "$wid" ] && [ -n "$pane" ] || {
    err "lane: warn: could not parse herdr workspace response; lane works in tmux but is not on the board"
    return 0
  }
  # The tab runs a tmux client, so the pane shows the live interactive
  # Claude UI while every keystroke still goes through tmux, never through
  # herdr's write path.
  herdr pane run "$pane" "exec tmux attach -t $session" >/dev/null 2>&1 || \
    err "lane: warn: herdr tab could not attach $session; attach by hand with: tmux attach -t $session"
  printf '%s' "$wid" > "$REGISTRY/$name/workspace"
  printf '%s' "$wid"
}

# --- subcommands -----------------------------------------------------------

cmd_health() {
  local fails=0 wrapper_cfg
  wrapper_cfg="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

  if [ -f "$CONF/config.json" ]; then
    if python3 -c 'import json,sys
print("yes" if sys.argv[1] in json.load(open(sys.argv[2])).get("allow", []) else "no")' \
        "$wrapper_cfg" "$CONF/config.json" 2>/dev/null | grep -q yes; then
      echo "ok    config: $wrapper_cfg is allowlisted"
    else
      echo "FAIL  config: $wrapper_cfg is NOT in allow in $CONF/config.json"
      fails=1
    fi
  else
    echo "FAIL  config: $CONF/config.json missing - run install.sh first"
    fails=1
  fi

  if command -v tmux >/dev/null 2>&1; then
    local n
    n="$(tmux ls -F '#{session_name}' 2>/dev/null | grep -c '^lane-' || true)"
    echo "ok    tmux: present, $n lane session(s)"
  else
    echo "FAIL  tmux: not on PATH (/opt/homebrew/bin or /usr/local/bin)"
    fails=1
  fi

  if herdr_ok; then
    echo "ok    herdr: present, server answering"
  else
    echo "warn  herdr: unavailable - lanes still work in tmux, but will not show on the board"
  fi

  if [ -f "$CONF/status.json" ]; then
    if python3 -c 'import json,sys,time
s = json.load(open(sys.argv[1]))
t = s.get("last_poll_ok")
sys.exit(0 if t and time.time() - t < 300 else 1)' "$CONF/status.json" 2>/dev/null; then
      echo "ok    poller: last successful poll under 5 minutes ago"
    else
      echo "warn  poller: no successful poll in the last 5 minutes (asleep? logged out?)"
    fi
  else
    echo "warn  poller: $CONF/status.json missing - poller has not written status yet"
  fi

  if [ "$fails" -eq 0 ]; then
    echo "LANE HEALTH: OK"
  else
    echo "LANE HEALTH: FAILED"
    return 1
  fi
}

cmd_up() { # <name>
  [ $# -eq 1 ] || usage 2 "lane up <name>"
  local name="$1" session dir wid launched
  valid_name "$name" || usage 2 "lane up <name> - name must match [a-z][a-z0-9-]{0,30}"
  command -v tmux >/dev/null 2>&1 || die "tmux not found on PATH"

  session="$(session_of "$name")"
  dir="$LANES_ROOT/$name"
  mkdir -p "$REGISTRY/$name/jobs" "$dir"
  lock_lane "$REGISTRY/$name"

  if [ -f "$REGISTRY/$name/state" ] && [ "$(cat "$REGISTRY/$name/state")" = active ] \
     && have_session "$session"; then
    echo "resumed: $name (tmux session $session already alive)"
  else
    # Ledger BEFORE effects: a retried `up` sees this record and takes the
    # resume path instead of making a second workspace.
    printf 'active\n' > "$REGISTRY/$name/state"
    if have_session "$session"; then
      echo "resumed: $name (adopted existing tmux session $session)"
    else
      tmux new-session -d -s "$session" -c "$dir" -x 220 -y 50
      echo "created: $name (tmux session $session, cwd $dir)"
    fi
  fi

  # Self-healing resume: a pane sitting at a shell (fresh session, or claude
  # exited, or the Mac rebooted and the session was recreated) gets claude
  # back. --continue picks the lane's conversation back up in the same cwd;
  # the jobs ledger marks whether this lane ever launched one.
  launched=no
  [ -f "$REGISTRY/$name/jobs/.launched" ] && launched=yes
  if shell_waiting "$session"; then
    if [ "$launched" = yes ]; then
      tmux send-keys -t "$session" -- "$CLAUDE_BIN --continue" Enter
      echo "agent: relaunched '$CLAUDE_BIN --continue' in $session"
    else
      tmux send-keys -t "$session" -- "$CLAUDE_BIN" Enter
      date +%s > "$REGISTRY/$name/jobs/.launched"
      echo "agent: started '$CLAUDE_BIN' in $session"
    fi
  elif agent_running "$session"; then
    echo "agent: already running in $session"
  else
    echo "warn: pane is running '$(pane_cmd "$session")', not a shell or claude - left untouched"
  fi

  wid="$(herdr_ensure_workspace "$name" "$dir" "$session")"
  if [ -n "$wid" ]; then
    echo "herdr: workspace $wid shows the live session"
  fi
  echo "up: $name - read it with: lane read $name"
}

cmd_prompt() { # <name> <job-id> <text...>
  [ $# -ge 3 ] || usage 2 "lane prompt <name> <job-id> <prompt text>"
  local name="$1" job="$2" session jobfile text hash
  shift 2
  valid_name "$name" || usage 2 "lane prompt <name> ... - bad lane name"
  valid_job "$job" || usage 2 "lane prompt <name> <job-id> ... - job id must match [A-Za-z0-9][A-Za-z0-9._-]{0,63}"
  text="$*"
  [ -n "$text" ] || usage 2 "lane prompt <name> <job-id> <prompt text> - empty prompt"
  [ "${#text}" -le "$MAX_PROMPT" ] || die "prompt is ${#text} chars, cap is $MAX_PROMPT - split it or write it to a file in the lane"

  session="$(session_of "$name")"
  [ -d "$REGISTRY/$name" ] || die "lane $name does not exist - run: lane up $name"
  lock_lane "$REGISTRY/$name"

  jobfile="$REGISTRY/$name/jobs/$job"
  if [ -f "$jobfile" ]; then
    # The ledger write happened before the original send, so an existing
    # record means this job was already accepted: never send it twice,
    # however the lane's state has changed since.
    echo "duplicate suppressed: job $job was already accepted by lane $name"
    cat "$jobfile"
    if ! grep -q '^submitted:' "$jobfile"; then
      echo "warn: no submitted timestamp in that record - the send may never have happened."
      echo "      Inspect the pane (lane read $name) before refiling under a NEW job id."
    fi
    return 0
  fi

  [ "$(cat "$REGISTRY/$name/state")" = active ] || die "lane $name is archived - run: lane up $name"
  have_session "$session" || die "tmux session $session is gone - run: lane up $name"
  agent_running "$session" || die "pane is running '$(pane_cmd "$session")', not claude - inspect with: lane read $name"

  hash="$(printf '%s' "$text" | shasum -a 256 | awk '{print $1}')"
  {
    printf 'job: %s\n' "$job"
    printf 'accepted: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'prompt_sha256: %s\n' "$hash"
    printf 'prompt_chars: %s\n' "${#text}"
  } > "$jobfile"

  # Bracketed paste (-p) drops the whole prompt into the TUI as paste, so
  # newlines in the text stay text; a separate Enter then submits. -d frees
  # the buffer after the paste.
  tmux set-buffer -b "lanejob-$job" -- "$text"
  if ! tmux paste-buffer -p -d -t "$session" -b "lanejob-$job" 2>/dev/null; then
    tmux delete-buffer -b "lanejob-$job" 2>/dev/null || true
    die "paste into $session failed"
  fi
  sleep 1
  tmux send-keys -t "$session" Enter
  printf 'submitted: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$jobfile"

  echo "submitted: job $job to $name (${#text} chars, sha256 ${hash:0:12}...)"
  echo "verify by reading the pane: lane read $name"
}

# --- control -------------------------------------------------------------
# A control command is not work. Its text is fixed by the table below -- the caller
# supplies no prose -- so it needs none of prompt's size and content handling, and it
# must not queue behind the work it exists to interrupt: it takes the lane lock only if
# the lock is free right now, and it fans out across every named lane at once instead of
# walking them one at a time.
control_text() { # <command>
  case "$1" in
    mute)   printf 'CONTROL: mute. Stop texting or notifying me from this lane until I say unmute. Keep working, and do not reply to this message.' ;;
    unmute) printf 'CONTROL: unmute. Texts and notifications from this lane are on again.' ;;
    *)      return 1 ;;
  esac
}

control_one() { # <command> <job-id> <name> - runs in its own subshell; returns, never exits
  local cmd="$1" job="$2" name="$3" session jobfile text
  session="$(session_of "$name")"
  [ -d "$REGISTRY/$name" ] || { err "lane $name: does not exist - skipped"; return 1; }
  jobfile="$REGISTRY/$name/jobs/$job"
  if [ -f "$jobfile" ]; then
    printf '%s: duplicate suppressed (job %s was already accepted)\n' "$name" "$job"
    return 0
  fi
  [ "$(cat "$REGISTRY/$name/state" 2>/dev/null)" = active ] || { err "lane $name: archived - skipped"; return 1; }
  have_session "$session" || { err "lane $name: no live tmux session - skipped"; return 1; }
  agent_running "$session" || { err "lane $name: pane is running '"'"'$(pane_cmd "$session")'"'"', not claude - skipped"; return 1; }

  text="$(control_text "$cmd")"
  try_lock_lane "$REGISTRY/$name" ||
    err "lane $name: work is in flight; sending the control anyway (control does not wait)"
  {
    printf 'job: %s\n' "$job"
    printf 'control: %s\n' "$cmd"
    printf 'accepted: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "$jobfile"
  tmux set-buffer -b "lanectl-$job-$name" -- "$text"
  if ! tmux paste-buffer -p -d -t "$session" -b "lanectl-$job-$name" 2>/dev/null; then
    tmux delete-buffer -b "lanectl-$job-$name" 2>/dev/null || true
    err "lane $name: paste failed"
    return 1
  fi
  tmux send-keys -t "$session" Enter
  printf 'submitted: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$jobfile"
  printf '%s: %s sent\n' "$name" "$cmd"
}

cmd_control() { # <command> <job-id> <name>...
  [ $# -ge 3 ] || usage 2 "lane control <mute|unmute> <job-id> <lane>..."
  local cmd="$1" job="$2" rc=0 pid pids="" seen=""
  shift 2
  control_text "$cmd" >/dev/null || usage 2 "lane control <mute|unmute> ... - unknown control command '"'"'$cmd'"'"'"
  valid_job "$job" || usage 2 "lane control <command> <job-id> ... - job id must match [A-Za-z0-9][A-Za-z0-9._-]{0,63}"
  for name in "$@"; do
    valid_name "$name" || usage 2 "lane control ... - bad lane name '"'"'$name'"'"'"
    case " $seen " in *" $name "*) continue ;; esac
    seen="$seen $name"
  done
  # Every lane at once: a mute that reaches the fourth lane a minute late is not a mute.
  for name in $seen; do
    control_one "$cmd" "$job" "$name" &
    pids="$pids $!"
  done
  for pid in $pids; do
    wait "$pid" || rc=1
  done
  return "$rc"
}

cmd_read() { # <name> [lines]
  [ $# -ge 1 ] && [ $# -le 2 ] || usage 2 "lane read <name> [lines]"
  local name="$1" lines="${2:-100}" session
  valid_name "$name" || usage 2 "lane read <name> - bad lane name"
  case "$lines" in ''|*[!0-9]*) usage 2 "lane read <name> [lines] - lines must be a number" ;; esac
  [ "$lines" -le "$MAX_READ" ] || lines="$MAX_READ"
  session="$(session_of "$name")"
  have_session "$session" || die "no live tmux session for $name (archived or rebooted) - state: $(cat "$REGISTRY/$name/state" 2>/dev/null || echo unknown)"
  echo "# lane: $name   session: $session   pane running: $(pane_cmd "$session")   lines: $lines"
  tmux capture-pane -p -t "$session" -S "-$lines"
}

cmd_list() {
  local name state session alive
  [ -d "$REGISTRY" ] || { echo "no lanes yet"; return 0; }
  for d in "$REGISTRY"/*/; do
    [ -d "$d" ] || continue
    name="$(basename "$d")"
    state="$(cat "$d/state" 2>/dev/null || echo unknown)"
    session="$(session_of "$name")"
    if have_session "$session"; then alive="tmux alive ($(pane_cmd "$session"))"; else alive="no live session"; fi
    printf '%-32s %-9s %s\n' "$name" "$state" "$alive"
  done
}

cmd_stop() { # <name>
  [ $# -eq 1 ] || usage 2 "lane stop <name>"
  local name="$1" session wid
  valid_name "$name" || usage 2 "lane stop <name> - bad lane name"
  [ -d "$REGISTRY/$name" ] || die "lane $name does not exist"
  session="$(session_of "$name")"
  lock_lane "$REGISTRY/$name"

  if have_session "$session"; then
    tmux kill-session -t "$session"
    echo "stopped: tmux session $session killed"
  else
    echo "stopped: no live tmux session"
  fi
  if [ -s "$REGISTRY/$name/workspace" ] && herdr_ok; then
    wid="$(cat "$REGISTRY/$name/workspace")"
    herdr workspace close "$wid" >/dev/null 2>&1 || true
    rm -f "$REGISTRY/$name/workspace"
    echo "herdr: workspace $wid closed"
  fi
  printf 'archived\n' > "$REGISTRY/$name/state"
  echo "archived: $name - ledger and $LANES_ROOT/$name kept; 'lane up $name' revives it"
}

case "${1:-}" in
  health) shift; [ $# -eq 0 ] || usage 2 "lane health"; cmd_health ;;
  up)     shift; cmd_up "$@" ;;
  prompt) shift; cmd_prompt "$@" ;;
  read)   shift; cmd_read "$@" ;;
  list)   shift; [ $# -eq 0 ] || usage 2 "lane list"; cmd_list ;;
  stop)   shift; cmd_stop "$@" ;;
  control) shift; cmd_control "$@" ;;
  *) usage 2 "lane <health|up|prompt|read|list|stop|control> ..." ;;
esac
